# cp .env.example .env 후 값을 채운다. .env는 커밋하지 않는다.
# data.go.kr 활용신청 후 받은 일반 인증키(Decoding 키) — D3~D5 배경 통계용
DATA_GO_KR_KEY=
# 없으면 AI 설명 대신 템플릿 설명만 사용
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# dev: 라벨 미확정이어도 개발용 번들 생성(r1_confirmed=false) / final: 미확정이면 에러
APP_MODE=dev
# FastAPI CORS 허용 출처(쉼표 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
# FastAPI가 서빙할 번들 경로(비우면 backend/dist/data)
BUNDLE_DIR=
