# cp .env.example .env 후 값을 채운다. .env는 커밋하지 않는다.
# data.go.kr 활용신청 후 받은 일반 인증키(Decoding 키) — D3~D5 배경 통계용
DATA_GO_KR_KEY=
# 없으면 AI 설명 대신 템플릿 설명만 사용
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# dev: 라벨 미확정이어도 개발용 번들 생성(r1_confirmed=false) / final: 미확정이면 에러
APP_MODE=dev
# FastAPI CORS 허용 출처(쉼표 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
# FastAPI가 서빙할 번들 경로(비우면 backend/dist/data)
BUNDLE_DIR=

# ── Neon·로그인 (docs/requests.md #15·#19) ──
# Neon 연결 문자열(postgresql://...?sslmode=require). 있으면 API·daily_sync가 DB를 쓴다. 채팅·코드에 붙이지 말 것
DATABASE_URL=
# 세션 토큰 서명용 비밀값(16자 이상, 아무 긴 무작위 문자열). 없으면 회원 기능 비활성
SESSION_SECRET=
# 로컬에서만 1 — 개발용 로그인(/api/auth/dev) 허용. 배포 환경에는 넣지 않는다
DEV_LOGIN=
# 구글 로그인 검증용(프론트의 NEXT_PUBLIC_GOOGLE_CLIENT_ID와 같은 값)
GOOGLE_CLIENT_ID=
# 서울 열린데이터광장 인증키 — 실내외 구분 검증(#28)
SEOUL_OPENAPI_KEY=
