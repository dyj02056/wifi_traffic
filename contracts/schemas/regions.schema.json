{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wifisafe.local/schemas/regions.schema.json",
  "title": "regions.json — 시도·시군구 목록과 지점 수, 시연 기본 지역",
  "type": "object",
  "required": ["default_region_id", "sido", "regions"],
  "properties": {
    "default_region_id": {"$ref": "_common.schema.json#/$defs/region_id"},
    "sido": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sido_code", "sido", "count"],
        "properties": {
          "sido_code": {"type": "string", "pattern": "^[0-9]{2}$"},
          "sido": {"type": "string"},
          "count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["region_id", "sido_code", "sido", "sigungu", "count", "available", "r1_status", "r1_coverage",
                     "center", "bbox"],
        "properties": {
          "region_id": {"$ref": "_common.schema.json#/$defs/region_id"},
          "sido_code": {"type": "string", "pattern": "^[0-9]{2}$"},
          "sido": {"type": "string"},
          "sigungu": {"type": "string"},
          "count": {"type": "integer", "minimum": 0},
          "available": {"type": "boolean", "description": "true면 points/detail/changes/sensitivity 파일이 번들에 있음"},
          "r1_status": {"enum": ["confirmed", "provisional", "no_ssid"],
                        "description": "provisional이면 이 지역을 볼 때 '임시(무효)' 배지·워터마크, no_ssid면 'SSID 정보 없음 — 보안접속 항목(R1)은 가정값' 배지만"},
          "r1_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1,
                          "description": "SSID 있는 행 중 확정 라벨 비율. no_ssid면 null. 기준은 rules.params.R1_REGION_COVERAGE_MIN"},
          "center": {
            "type": "object", "required": ["lat", "lng"],
            "properties": {"lat": {"$ref": "_common.schema.json#/$defs/lat"}, "lng": {"$ref": "_common.schema.json#/$defs/lng"}},
            "additionalProperties": false
          },
          "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4,
                   "description": "[minLng, minLat, maxLng, maxLat]"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
