{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wifisafe.local/schemas/cases.schema.json",
  "title": "cases.json — 같은 원리 사례 카드 (출처·날짜 필수)",
  "type": "object",
  "required": ["label", "cases"],
  "properties": {
    "label": {"const": "같은 원리 사례 — 국내 공공와이파이 사건 아님"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "principle", "related_rules", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "principle": {"type": "string", "minLength": 1},
          "related_rules": {"type": "array", "items": {"$ref": "_common.schema.json#/$defs/rule_id"}},
          "source": {
            "allOf": [
              {"$ref": "_common.schema.json#/$defs/source_ref"},
              {"required": ["published_at"], "properties": {"published_at": {"$ref": "_common.schema.json#/$defs/date"}}}
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
