{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wifisafe.local/schemas/_common.schema.json",
  "title": "공용 정의",
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "region_id": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"},
    "point_key": {"type": "string", "pattern": "^[0-9a-f]{10}$"},
    "rule_id": {"type": "string", "enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8"]},
    "grade_label": {"type": "string", "enum": ["낮음", "주의", "높음"]},
    "ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "r_vector": {"type": "array", "items": {"$ref": "#/$defs/ratio"}, "minItems": 8, "maxItems": 8},
    "lat": {"type": "number", "minimum": 33, "maximum": 39.5},
    "lng": {"type": "number", "minimum": 124, "maximum": 132},
    "source_ref": {
      "type": "object",
      "required": ["name", "url", "retrieved_at"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dataset_id": {"type": ["string", "null"]},
        "url": {"type": "string", "minLength": 1},
        "published_at": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "retrieved_at": {"$ref": "#/$defs/date"}
      },
      "additionalProperties": false
    }
  }
}
